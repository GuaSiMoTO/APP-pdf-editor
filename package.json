{
  "name": "folio",
  "private": true,
  "description": "Atajos para lanzar Folio desde la raíz del proyecto",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "api": "cd server && .venv\\Scripts\\uvicorn app.main:app --reload --reload-dir app --port 8000",
    "build": "npm --prefix web run build",
    "lint": "npm --prefix web run lint",
    "test": "npm --prefix web test && npm run test:api",
    "test:api": "cd server && .venv\\Scripts\\python -m pytest -q"
  }
}
